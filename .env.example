# --- PERPLEXTA PRODUCTION ENVIRONMENT ---
# IDENTITY: Professional Elite AI Platform

# [NETWORK SETTINGS]
# PORT: The port the server listens on. (Default: 3000)
# Ensure this port is open in your server firewall.
PORT=3000

# NODE_ENV: Set to 'production' for live deployments.
NODE_ENV="production"

# DB_SSL_REQUIRED: Set to 'false' for local PostgreSQL servers that don't use SSL.
DB_SSL_REQUIRED="false"

# APP_URL: The primary address of your server (e.g., https://yourdomain.com).
APP_URL="http://localhost:3000"

# CORS_ALLOWED_ORIGINS: Comma-separated list of origins permitted for API access.
CORS_ALLOWED_ORIGINS="https://your-domain.com,https://another-domain.com"

# TRUST_PROXIES: Define trusted proxies for secure rate-limiting behind reverse proxies (e.g. Cloudflare, corporate WAFs, cPanel, or 1 to trust first-hop)
TRUST_PROXIES="1"

# VITE_APP_URL: Should match your APP_URL.
VITE_APP_URL="http://localhost:3000"

# [DATABASE CONFIGURATION]
# DATABASE_URL: Main Operational Database (Users, Chats, Plans)
DATABASE_URL="postgresql://user:password@localhost:5432/platform_core"

# LEDGER_DATABASE_URL: Finance Vault Database (Wallets, Transactions)
LEDGER_DATABASE_URL="postgresql://user:password@localhost:5432/platform_ledger"

# EXTERNAL_DATABASE_URL: External Categories Database (Forums, Articles, Blog)
EXTERNAL_DATABASE_URL="postgresql://user:password@localhost:5432/platform_external"

# SECURITY_DATABASE_URL: Anti-Flooding Database (Security limits, Blacklists)
SECURITY_DATABASE_URL="postgresql://user:password@localhost:5432/platform_security"

# DB_MAX_CONNECTIONS: Global default pool size limit (Default: 20)
DB_MAX_CONNECTIONS="20"

# [DATABASE POOL TUNING PARAMETERS]
# DB_CORE_MAX_POOL_SIZE: Max connections override for the Core database pool
# DB_LEDGER_MAX_POOL_SIZE: Max connections override for the Ledger database pool
# DB_EXTERNAL_MAX_POOL_SIZE: Max connections override for the External database pool
# DB_SECURITY_MAX_POOL_SIZE: Max connections override for the Security database pool

# [SECURITY VAULT]
# ENCRYPTION_KEY: AES-256 Master Key. Must be exactly 32 characters.
ENCRYPTION_KEY="your_secure_32_chars_key_here_!"

# JWT_SECRET: Security key for session signing. MUST be changed in production.
JWT_SECRET="your_secure_jwt_secret_here"

# [ADMIN ACCESS]
# ADMIN_EMAIL: The primary administrator email for backend access.
ADMIN_EMAIL="admin@example.com"

# VITE_ADMIN_EMAIL: The primary administrator email for dashboard access.
VITE_ADMIN_EMAIL="admin@example.com"

# ADMIN_PASSWORD: The initial password for the Master Administrator account.
# PLEASE CHANGE THIS AFTER FIRST LOGIN.
ADMIN_PASSWORD=

# STRIPE_SECRET_KEY: Optional. Can be configured via the Admin Panel.
# Using a placeholder prevents SDK crashes during initial server startup.
STRIPE_SECRET_KEY="sk_test_placeholder"

# GOOGLE_OAUTH: Required for "Continue with Google" (Obtain from Google Cloud Console)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"

# [SECURE ECONOMY DEFAULT FALLBACKS]
DEFAULT_CRYPTO_ADDRESS="YOUR_TEST_CRYPTO_WALLET_ADDRESS"
DEFAULT_BANK_NAME="Your Test Bank"
DEFAULT_BANK_RECIPIENT="Your Test Corporate Name LTD"
DEFAULT_BANK_IBAN="YOUR_TEST_IBAN_NUMBER"
DEFAULT_BANK_SWIFT="YOUR_TEST_SWIFT_CODE"
DEFAULT_PAYPAL_EMAIL="sandbox-paypal@yourdomain.com"

# [X402 PROTOCOL SETTINGS]
X402_WALLET_ADDRESS="0xYourX402WalletAddress"
X402_FACILITATOR_URL="https://api.x402.org"



# Firebase Admin for Native Push Notifications
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=

