# =============================================================================
# ENVIRONMENT VARIABLES (CRITICAL SECURITY)
# =============================================================================
# Ignore all .env files
.env
.env.*

# EXCEPT these templates/examples (safe to commit)
!.env.example
!.env.template
!.env.local.example
!.env.sample

